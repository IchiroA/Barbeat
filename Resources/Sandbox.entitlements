<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store builds must run in the App Sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Lights: Hue Bridge and Art-Net devices on the local network (Art-Net node search listens for answers). -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Scenes: importing and exporting scene files through the open and save panels. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Needed for the system-audio tap. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
